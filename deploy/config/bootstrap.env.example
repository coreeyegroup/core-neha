# First administrators for a new tenant. Two different people: one requests
# access changes, the other approves them. Copy to ~/core-neha/config/bootstrap.env.
CORE_NEHA_BOOTSTRAP_TENANT_CODE=example-group
CORE_NEHA_BOOTSTRAP_TENANT_NAME=Example Hospital Group
CORE_NEHA_BOOTSTRAP_ADMIN1_GIVEN_NAME=First
CORE_NEHA_BOOTSTRAP_ADMIN1_FAMILY_NAME=Administrator
CORE_NEHA_BOOTSTRAP_ADMIN1_EMAIL=first.admin@example.invalid
CORE_NEHA_BOOTSTRAP_ADMIN1_USERNAME=first.admin
CORE_NEHA_BOOTSTRAP_ADMIN2_GIVEN_NAME=Second
CORE_NEHA_BOOTSTRAP_ADMIN2_FAMILY_NAME=Approver
CORE_NEHA_BOOTSTRAP_ADMIN2_EMAIL=second.approver@example.invalid
CORE_NEHA_BOOTSTRAP_ADMIN2_USERNAME=second.approver
