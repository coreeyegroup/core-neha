# core-neha deployment settings (not secret). The live copy is
# ~/core-neha/config/core-neha.env, outside Git. Change the two address
# settings together when moving to another domain or server (ADR-0004).
CORE_NEHA_ENVIRONMENT=demo
CORE_NEHA_PUBLIC_BASE_URL=https://coreeye.in/core-neha
CORE_NEHA_BASE_PATH=/core-neha
CORE_NEHA_HTTP_PORT=18400
CORE_NEHA_KC_ADMIN_PORT=18480
