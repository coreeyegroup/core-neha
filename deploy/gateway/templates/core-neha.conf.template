upstream core_neha_keycloak { server keycloak:8080; keepalive 16; }
upstream core_neha_backend  { server backend:8080;  keepalive 16; }

server {
  listen 8080;
  server_name _;

  # Container health only; Caddy forwards ${CORE_NEHA_BASE_PATH}/* and never reaches this.
  location = /__gateway_health { access_log off; default_type text/plain; return 200 "ok\n"; }

  location = ${CORE_NEHA_BASE_PATH} { return 308 ${CORE_NEHA_BASE_PATH}/; }

  # Identity: public login endpoints only. Administration uses the localhost-only port.
  # The account console is closed: users cannot remove their own authenticator or change
  # sign-in settings; administrators do that in core-neha (one-time code control).
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/admin                   { return 403; }
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/realms/master           { return 403; }
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/realms/core-neha/account { return 403; }
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/metrics                 { return 403; }
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/health                  { return 403; }
  location ^~ ${CORE_NEHA_BASE_PATH}/auth/ {
    proxy_pass http://core_neha_keycloak;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $xf_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $xf_proto;
    proxy_set_header X-Forwarded-Host  $xf_host;
    proxy_set_header X-Forwarded-Port  $xf_port;
    proxy_set_header X-Request-Id      $request_id;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
  }

  # Backend API (Spring Boot, context path ${CORE_NEHA_BASE_PATH}/api).
  # Image archive (Orthanc DICOMweb and the OHIF viewer). Read only, and every request is checked by
  # the backend: the viewer's files for imaging staff, and one named study at a time for users who may
  # see it. Searching the whole archive and the archive's own pages and API are refused there.
  location = /__imaging_authorize {
    internal;
    proxy_pass http://core_neha_backend${CORE_NEHA_BASE_PATH}/api/v1/imaging/authorize;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header Host $xf_host;
    proxy_set_header X-Forwarded-Proto $xf_proto;
    proxy_set_header X-Forwarded-Host $xf_host;
    proxy_set_header X-Forwarded-Port $xf_port;
  }
  location ^~ ${CORE_NEHA_BASE_PATH}/api/pacs/ {
    limit_except GET HEAD { deny all; }
    auth_request /__imaging_authorize;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $orthanc http://orthanc:8042;
    rewrite ^${CORE_NEHA_BASE_PATH}/api/pacs/(.*)$ /$1 break;
    proxy_pass $orthanc;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host orthanc;
    proxy_hide_header Set-Cookie;
    add_header Cache-Control "private, no-store" always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 1k;
  }

  location ^~ ${CORE_NEHA_BASE_PATH}/api/ {
    proxy_pass http://core_neha_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host              $xf_host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $xf_proto;
    proxy_set_header X-Forwarded-Host  $xf_host;
    proxy_set_header X-Forwarded-Port  $xf_port;
    proxy_set_header X-Request-Id      $request_id;
    add_header Cache-Control "no-store" always;
  }

  # The identity provider returns here after sign-out (registered address); show the staff app's page.
  location = ${CORE_NEHA_BASE_PATH}/signed-out { return 302 ${CORE_NEHA_BASE_PATH}/staff/signed-out$is_args$args; }
  location = ${CORE_NEHA_BASE_PATH}/staff { return 308 ${CORE_NEHA_BASE_PATH}/staff/; }

  # Staff application: hashed assets are immutable; the page itself is always revalidated.
  location ^~ ${CORE_NEHA_BASE_PATH}/staff/assets/ {
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  location ^~ ${CORE_NEHA_BASE_PATH}/staff/ {
    root /usr/share/nginx/html;
    try_files $uri $uri/ ${CORE_NEHA_BASE_PATH}/staff/index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  }

  # Public website (static pages). No cookies, no scripts from other sites.
  location ^~ ${CORE_NEHA_BASE_PATH}/ {
    root /usr/share/nginx/html;
    index index.html;
    try_files $uri $uri.html $uri/ =404;
    error_page 404 ${CORE_NEHA_BASE_PATH}/404.html;
    add_header Cache-Control "public, max-age=300" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  }

  location / { return 404; }
}
